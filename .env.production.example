# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# (no password set; restrict access to the Docker network instead)

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_DAYS=30

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://whots.app
APP_URL=https://whots.app

# ── SMTP (email) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
SMTP_FROM=noreply@whots.app

# ── Observability ─────────────────────────────────────────────────────────────
RUST_LOG=whots_server=info,tower_http=info
